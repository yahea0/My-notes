<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070708"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_normal"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ملاحظة جديدة"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSaveNote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_active"
            android:src="@android:drawable/checkbox_on_background"
            android:contentDescription="Save" />
    </LinearLayout>

    <EditText
        android:id="@+id/etNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_chip_normal"
        android:hint="عنوان الملاحظة"
        android:textColor="#FFFFFF"
        android:textColorHint="#777780"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:inputType="text" />

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_chip_normal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etNoteContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chip_normal"
        android:gravity="top|start"
        android:hint="اكتب ملاحظتك هنا..."
        android:textColor="#FFFFFF"
        android:textColorHint="#777780"
        android:textSize="15sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/btnDeleteNote"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_chip_normal"
        android:text="حذف الملاحظة"
        android:textColor="#FF5555"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>
